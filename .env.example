# Copy to .env and fill in. Never commit .env.

# --- Model provider (required) ---
ANTHROPIC_API_KEY=sk-ant-...
SEV0_MODEL=claude-sonnet-4-6

# --- Git hosting (required for pull request creation) ---
# Fine-grained token with Contents: read/write and Pull requests: read/write
GITHUB_TOKEN=ghp_...
SEV0_REPO=owner/repository
SEV0_BASE_BRANCH=main

# --- Observability sources (at least one recommended) ---
# Leave blank to run against the bundled Incident Lab stack on localhost.
SEV0_LOKI_URL=http://localhost:3100
SEV0_PROMETHEUS_URL=http://localhost:9090
SEV0_TEMPO_URL=http://localhost:3200

# --- Sandbox ---
# Container runtime used to reproduce failures and run tests.
SEV0_SANDBOX_RUNTIME=docker
SEV0_SANDBOX_TIMEOUT_SECONDS=600
SEV0_SANDBOX_NETWORK=none

# --- Safety rails ---
# Hard limits the agent may never exceed. See docs/SAFETY.md.
SEV0_MAX_FILES_CHANGED=5
SEV0_MAX_LINES_CHANGED=120
SEV0_MAX_TOOL_CALLS=60
SEV0_REQUIRE_HUMAN_APPROVAL=true
SEV0_PROTECTED_PATHS=migrations/,infra/,.github/

# --- Run output ---
SEV0_RUN_DIR=./runs
SEV0_LOG_LEVEL=INFO
