# Storefront tunables.
#
# Kept in the repository rather than in the deployment so that a change to any
# of them shows up in git history like any other change. A setting that can be
# altered without leaving a trace is a setting nobody can debug.

# --- cart ---------------------------------------------------------------
# Connections held open to Postgres. Too few and requests queue behind each
# other under load; too many and the database runs out of backends.
DB_POOL_MAX_SIZE=10
# How long a request waits for a free connection before giving up.
DB_POOL_TIMEOUT=5
# Sales tax, in basis points. 875 is 8.75%.
TAX_BASIS_POINTS=875
# Master switch for discount codes. Off means codes are accepted and ignored.
PROMOTIONS_ENABLED=true
# Largest quantity a single cart line may hold after merging.
MAX_LINE_QUANTITY=99

# --- gateway ------------------------------------------------------------
# How long the gateway waits on a downstream service before treating the call
# as failed. Has to exceed the slowest thing behind it plus its retries.
GATEWAY_TIMEOUT_SECONDS=5
GATEWAY_CONNECT_TIMEOUT_SECONDS=2
# Total attempts, not retries after the first. 1 disables retrying entirely.
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_RETRY_BACKOFF_SECONDS=0.05

# --- payments -----------------------------------------------------------
# Baseline processor latency and its jitter, in milliseconds.
PAYMENTS_BASE_LATENCY_MS=35
PAYMENTS_LATENCY_JITTER_MS=25
# Share of charges the processor declines. Real processors decline some.
PAYMENTS_DECLINE_RATE=0.02
# Ceiling on a single charge. A total above this is a pricing bug upstream.
PAYMENTS_MAX_CHARGE_CENTS=500000

# --- catalog ------------------------------------------------------------
# Share of catalog reads that fail with a transient error, so that the
# retry path is exercised by real traffic rather than only by tests.
CATALOG_ERROR_RATE=0.01
CATALOG_LATENCY_MS=0
